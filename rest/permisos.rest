  "subject": "user"
}




### Crear permiso (sin label - es opcional)
POST {{baseUrl}}/permissions
Content-Type: {{contentType}}

{
  "actions": "delete",
  "subject": "role"
}

### Crear permiso (debería fallar - actions/subject duplicados)
POST {{baseUrl}}/permissions
Content-Type: {{contentType}}

{
  "label": "Duplicado",
  "actions": "create",
  "subject": "user"
}

### Crear permiso (debería fallar - validación, falta actions)
POST {{baseUrl}}/permissions
Content-Type: {{contentType}}

{
  "label": "Permiso incompleto",
  "subject": "user"
}

### Crear permiso (debería fallar - label excede maxLength)
POST {{baseUrl}}/permissions
Content-Type: {{contentType}}

{
  "label": "Este label es demasiado largo y supera los cincuenta caracteres permitidos",
  "actions": "read",
  "subject": "report"
}



### Obtener un permiso por id
# Reemplaza el 1 por un id real que te haya devuelto el POST
GET {{baseUrl}}/permissions/1

### Obtener un permiso que no existe (debería dar 404)
GET {{baseUrl}}/permissions/9999
