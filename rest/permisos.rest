
@baseUrl = http://localhost:3000
@contentType = application/json


### Listar todos los permisos
GET {{baseUrl}}/permission

### Crear permiso (con label)
POST {{baseUrl}}/permission
Content-Type: application/json

{
  "label": "Crear usuario",
  "actions": "create",
  "subject": "user"
}


### Crear permiso (otro, para tener varios ids disponibles)
POST {{baseUrl}}/permission
Content-Type: application/json

{
  "label": "Editar usuario",
  "actions": "update",
  "subject": "user"
}


### Leer permiso 
POST {{baseUrl}}/permission
Content-Type: application/json

{
  "label": "Leer usuario",
  "actions": "read",
  "subject": "user"
}



### Eliminar permiso 
POST {{baseUrl}}/permission
Content-Type: application/json

{
  "label": "Eliminar usuario",
  "actions": "delete",
  "subject": "user"
}

### Listar permiso 
POST {{baseUrl}}/permission
Content-Type: application/json

{
  "label": "listar usuario",
